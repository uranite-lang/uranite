    SYS_RECVFROM,
    SYS_SENDMSG,
    SYS_RECVMSG,
    SYS_BIND,
    SYS_LISTEN,
    SYS_SETSOCKOPT,
    SYS_GETSOCKOPT,
    SYS_GETSOCKNAME,
    SYS_GETPEERNAME,
    SYS_SHUTDOWN,
    SYS_SOCKETPAIR,
    scAccess,
    scChmod,
    scChown,
    scDup2,
    scEpollCreate1,
    scFork,
    scFork,
    scEpollCtl,
    scEpollWait,
    scLink,
