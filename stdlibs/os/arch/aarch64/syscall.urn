    SYS_TIMERFD_SETTIME,
    SYS_CLONE,
    SYS_DUP3,
    SYS_EXECVE,
    SYS_EXIT_GROUP,
    SYS_FORK,
    SYS_GETEGID,
    SYS_GETEUID,
    SYS_GETGID,
    SYS_GETPGID,
    SYS_GETPPID,
    SYS_GETUID,
    SYS_KILL,
    SYS_SETSID,
    SYS_WAIT4,
    SYS_SOCKET,
    SYS_CONNECT,
    SYS_ACCEPT,
